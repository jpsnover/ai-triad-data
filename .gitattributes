# Default: let Git auto-detect text files and normalize line endings
* text=auto

# Structured data & docs
*.json text
*.md   text
*.yml  text
*.yaml text
*.csv  text
*.txt  text

# Shell scripts must stay LF on all platforms to run correctly
.githooks/*  text  eol=lf

# Binary assets
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
