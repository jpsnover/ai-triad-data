# Default: let Git auto-detect text files and normalize line endings
* text=auto

# Structured data & docs
# Data JSON is machine-written LF-only, UTF-8 no-BOM by the AITriad serializers
# (docs/edges-json-format.md byte contract). Pin eol=lf so checkout writes LF on every
# platform, matching what the writers emit and keeping non-git byte consumers correct.
*.json text eol=lf
*.md   text
*.yml  text
*.yaml text
*.csv  text
*.txt  text

# Shell scripts must stay LF on all platforms to run correctly
.githooks/*  text  eol=lf

# Binary assets
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
