# Default: let Git auto-detect text files and normalize line endings
* text=auto

# Structured data & docs: always LF (matches code repo & Electron readers)
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf

# Binary assets
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
