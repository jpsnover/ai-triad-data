#!/usr/bin/env bash
# Situation BDI pre-commit check (t/3892). Called from .githooks/pre-commit.
#
# Refuses (once promoted) a commit whose STAGED situations.json introduces or
# modifies a situation without a per-POV {belief, desire, intention} decomposition.
# Changed-only: an untouched legacy node never blocks an unrelated commit.
#
# WHY HERE: this is the last boundary every writer of situations.json shares --
# editor, PowerShell, pipeline, and direct agent JSON edits (t/3671#14, t/3892).
#
# WHAT IT READS (t/3892#2):
#   candidate = `git show :<path>`  -- the content being committed. Honours
#               GIT_INDEX_FILE, so a pathspec commit sees its temp index (t/3851#6).
#               NOT the working tree: on a shared checkout another agent's
#               unstaged edit must not be validated.
#   baseline  = `git show HEAD:<path>`
#   rule      = Get-SituationBdiViolationsFromJson + Test-SituationBdiDecomposition,
#               read from the CODE repo's ${AI_TRIAD_CHECKER_REF:-origin/main} BLOB,
#               not its working tree: the shared code checkout can be stale or carry
#               uncommitted edits, and the gate must enforce reviewed code only.
#               Freshness is the code repo's last fetch.
#
# WHY NOT `Import-Module AITriad`: 6-17 s per commit (measured, t/3892#2) drives
# --no-verify, which disarms every data-repo guard. Loading two files takes ~0.9 s.
#
# WARN-ONLY for now. Per Gate Promotion it stays advisory for >=1 real green cycle,
# and the flip to blocking (WARN_ONLY=0) needs a mandatory Second Opinion. When
# reading the warn cycle, look for the printed WARNING lines -- this script exits 0
# in warn mode whether or not it fired, so "the commit succeeded" proves nothing
# (Sage #202).
#
# EXECUTION RECORD (t/3892#6): every run appends one JSON line to
# <common git dir>/hook-telemetry.jsonl -- untracked, shared by all worktrees of the
# checkout -- with result (skip|pass|violation|unverified), action (allowed|refused),
# ms, worktree, index file and HEAD. The printed WARNING goes to whichever terminal ran
# the commit and a pass prints nothing, so without this record the warn cycle cannot be
# read and a dead hook is indistinguishable from a passing one (Live-Fire Proof, t/3396).
# Read it: `tail "$(git rev-parse --git-common-dir)/hook-telemetry.jsonl"`.
# AI_TRIAD_HOOK_TELEMETRY overrides the path (probes and harnesses point it elsewhere so
# they never pollute the real cycle). The append is isolated: any failure in it is
# swallowed and can never change the verdict.
#
# COULD NOT VERIFY (pwsh missing, checker unreadable, JSON unparseable) is reported
# as unverified, never as a pass; it blocks too once promoted.
#
# Not covered (after-push compliance, t/3671, is the backstop): --no-verify,
# clones without core.hooksPath (t/3869), server-side writes (bot, merges, API).

set -uo pipefail
export MSYS_NO_PATHCONV=1   # keep `:path` / `HEAD:path` revspecs intact under Git-for-Windows bash

WARN_ONLY=1
WATCH="taxonomy/Origin/situations.json"
TAG="[situation-bdi]"

now_ms () { local t; t="$(date +%s%3N 2>/dev/null)"; case "$t" in ''|*[!0-9]*) t="$(( $(date +%s) * 1000 ))" ;; esac; printf '%s' "$t"; }
T0="$(now_ms)"
record () {  # $1 = skip|pass|violation|unverified   $2 = allowed|refused   $3 = detail
  {
    local common log wt det
    common="$(git rev-parse --path-format=absolute --git-common-dir)"
    log="${AI_TRIAD_HOOK_TELEMETRY:-$common/hook-telemetry.jsonl}"
    [ "$(git rev-parse --absolute-git-dir)" = "$common" ] && wt=false || wt=true
    det="$(printf '%s' "${3:-}" | tr -d '"\\' | tr '\r\n\t' '   ' | cut -c1-300)"
    printf '{"ts":"%s","hook":"situation-bdi","result":"%s","action":"%s","warn_only":%s,"ms":%s,"worktree":%s,"index":"%s","head":"%s","detail":"%s"}\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$([ "$WARN_ONLY" -eq 1 ] && echo true || echo false)" \
      "$(( $(now_ms) - T0 ))" "$wt" "$(basename "${GIT_INDEX_FILE:-index}")" \
      "$(git rev-parse --short HEAD 2>/dev/null)" "$det" >> "$log"
  } 2>/dev/null || true
}

# Only when situations.json is part of this commit.
git diff --cached --name-only -- "$WATCH" | grep -qxF "$WATCH" || { record skip allowed "situations.json not in commit"; exit 0; }
# A whole-file deletion is not this check's concern (node removals: commit-msg, t/3851).
git cat-file -e ":$WATCH" 2>/dev/null || { record skip allowed "situations.json deleted"; exit 0; }

finish () {  # $1 = pass|violation|unverified   $2 = detail for the record
  if [ "$1" != pass ] && [ "$WARN_ONLY" -eq 0 ]; then
    record "$1" refused "${2:-}"
    echo "$TAG BLOCKING: commit refused." >&2
    exit 1
  fi
  record "$1" allowed "${2:-}"
  [ "$1" != pass ] && echo "$TAG WARN-ONLY: commit allowed. Will block once promoted (t/3892)." >&2
  exit 0
}
unverified () {
  echo "" >&2
  echo "$TAG COULD NOT VERIFY: $1" >&2
  echo "  The staged situations were NOT checked. This is not a pass." >&2
  finish unverified "$1"
}

tmp="$(mktemp -d)" || unverified "could not create a temp dir"
trap 'rm -rf "$tmp"' EXIT

git show "HEAD:$WATCH" > "$tmp/base.json" 2>/dev/null || : > "$tmp/base.json"   # no HEAD copy = first commit
git show ":$WATCH"     > "$tmp/cand.json" 2>/dev/null || unverified "could not read the staged $WATCH"

command -v pwsh >/dev/null 2>&1 || unverified "pwsh not found on PATH"

# Default code root = sibling of the data repo's MAIN checkout, found via the common git dir.
# NOT --show-toplevel: inside a data worktree (.worktrees/<name>) that is the worktree, so the
# sibling became .worktrees/ai-triad-research and every worktree commit read COULD NOT VERIFY.
# Worktrees are the sanctioned way to commit data, so this mattered. Found by the deployed
# live-fire 2026-10-05; the GV harness set AI_TRIAD_CODE_ROOT and never ran this default (#192).
DATA_MAIN="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
CODE_ROOT="${AI_TRIAD_CODE_ROOT:-$DATA_MAIN/../ai-triad-research}"
# MSYS_NO_PATHCONV=1 (above) also stops POSIX paths being converted for git.exe, so a
# POSIX-form override (/c/Users/...) would not resolve and every commit would read
# COULD NOT VERIFY. Normalise to a Windows-form path git.exe understands. (Found when a
# latency probe invoked the hook directly; `git commit` had been converting the env var
# for the GV runs, which is why they passed.)
if command -v cygpath >/dev/null 2>&1; then CODE_ROOT="$(cygpath -m "$CODE_ROOT")"; fi
REF="${AI_TRIAD_CHECKER_REF:-origin/main}"
# Git exports GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE to hooks, and GIT_DIR beats -C: without
# clearing them, `git -C <code repo>` silently reads the DATA repo and the rule is never found
# (seen in worktree commits, live-fire 2026-10-05). Clear them for code-repo reads only; the
# staged-content read above must keep GIT_INDEX_FILE.
code_git () {
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_PREFIX \
      -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES git -C "$CODE_ROOT" "$@"
}
code_git show "$REF:scripts/AITriad/Private/Test-SituationBdiDecomposition.ps1" \
  > "$tmp/classifier.ps1" 2>/dev/null || unverified "classifier not readable at $REF in $CODE_ROOT"
code_git show "$REF:scripts/AITriad/Public/Get-SituationBdiViolationsFromJson.ps1" \
  > "$tmp/checker.ps1" 2>/dev/null || unverified "checker not readable at $REF in $CODE_ROOT"

# pwsh is a native Windows binary: hand it Windows paths when running under MSYS.
winpath () { if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi; }
RUNNER="$(dirname "$0")/situations-bdi-runner.ps1"
[ -f "$RUNNER" ] || unverified "runner missing: $RUNNER"

out="$(pwsh -NoProfile -NonInteractive -File "$(winpath "$RUNNER")" \
        -BaselinePath "$(winpath "$tmp/base.json")" -CandidatePath "$(winpath "$tmp/cand.json")" \
        -ClassifierPath "$(winpath "$tmp/classifier.ps1")" -CheckerPath "$(winpath "$tmp/checker.ps1")" 2>&1)"
rc=$?

case "$rc" in
  0) finish pass "" ;;
  1)
    # t/4022 EXIT-CODE COLLISION FIX: the runner's OWN try/catch already converts an
    # internal load/parse failure to exit 2 (COULD-NOT-VERIFY) -- but pwsh exits 1 for a
    # failure OUTSIDE that try/catch too (the runner file not found, or a parse error in
    # the .ps1 that fails before the try block is ever reached), the SAME code the runner
    # uses for "violations found." Unconditionally treating rc=1 as a violation then fires
    # a WARNING naming zero violations (nothing was ever printed) instead of failing
    # closed. Require at least one real VIOLATION line before calling it a violation.
    VIOLATIONS="$(printf '%s\n' "$out" | awk -F'\t' '$1=="VIOLATION"{print $2}' | sort -u | paste -sd, -)"
    if [ -n "$VIOLATIONS" ]; then
      echo "" >&2
      echo "$TAG WARNING: staged situations are not BDI-decomposed:" >&2
      printf '%s\n' "$out" | awk -F'\t' '$1=="VIOLATION"{printf "    %s  [%s]  %s\n",$2,$3,$4}' >&2
      echo "" >&2
      echo "  Each POV needs non-empty belief, desire and intention (not N/A, none, tbd, -)." >&2
      echo "  Create situations through the editor or New-SituationNode, which decompose them." >&2
      finish violation "$VIOLATIONS"
    else
      FIRSTLINE="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | head -n 1)"
      unverified "checker failed: ${FIRSTLINE:-runner exited 1 with no output}"
    fi
    ;;
  *)
    unverified "$(printf '%s\n' "$out" | awk -F'\t' '$1=="COULD-NOT-VERIFY"{print $2}' | head -1) (runner exit $rc)" ;;
esac
