  $(document).on('click', '.map__marker', function () {
    const marker = $(this)
    const sidebar = $('.mapshow__sidebar')

    if (marker.hasClass('map__marker--hover')) {

      marker.removeClass('map__marker--hover')
      sidebar.removeClass('mapshow__sidebar--hover')
      $('.js-map-sidebar-item').removeClass('mapshow-sidebar-item--hover')

    } else {

      let otherMarker = $('.map__marker--hover')
      if (otherMarker.length) {
        $('.js-map-sidebar-item').removeClass('mapshow-sidebar-item--hover')
        otherMarker.removeClass('map__marker--hover')
      }

      const sidebarItem = $('.js-map-sidebar-item[data-id="' + marker.data('id') + '"]')

      if ((!isMobile() && !marker.hasClass('js-map-cluster-zoom')) || isMobile()) {
        marker.addClass('map__marker--hover')
        sidebar.addClass('mapshow__sidebar--hover')
        sidebarItem.addClass('mapshow-sidebar-item--hover')
      }

      if (isMobile()) {
        const container = $('.js-map-sidebar-items')
        const selectedItems = container.find('.mapshow-sidebar-item--hover')

        $('.mapshow__sidebar').addClass('mapshow__sidebar--visible')

        container.addClass('mapshow-sidebar__items--disable-snap')

        container.scrollLeft(0)

        setTimeout(function () {
          container.removeClass('mapshow-sidebar__items--disable-snap')
        })
      } else if (marker.hasClass('js-mapshow-scroll')) {
        const sidebarScroller = $('.mapshow__sidebar-scroller')
        let top = sidebarScroller.scrollTop() + sidebarItem.offset().top - $('.header').height()

        sidebarScroller.animate({
          scrollTop: top
        }, 300)
      }
    }
  })

