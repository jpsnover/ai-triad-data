  $(window).on('hashchange', function (e) {
    console.log('hash changed')
    if (location.hash) {
      hash = location.hash.substr(1)

      const videoAccordion = $('.video-accordion[data-hash="' + hash + '"]')

      if (hash.substr(0, 4) == 'rsvp') {
        const form = $('.overlayer-form[data-overlayer="rsvp"]')

        form.fadeIn(fadeDuration)
        form.find('.form__input').eq(0).focus()
        if (hash.substr(0, 5) == 'rsvp-') {
          $('[name="rsvp_email"]').val(hash.substr(5));
        }
      } else if (hash == 'subscribe') {
        const form = $('.overlayer-form[data-overlayer="subscribe"]')

        form.fadeIn(fadeDuration)
        form.find('.form__input').eq(0).focus()
      } else if (hash == 'login') {
        const form = $('.overlayer-form[data-overlayer="login"]')

        form.fadeIn(fadeDuration)
        form.find('.form__input').eq(0).focus()
      } else if (hash == 'issues') {
        e.preventDefault()
        if($('#issues').length){
          $(window).scrollTop($('#issues').offset().top - 65)
        }

      } else if (hash == 'upcoming' || hash == 'archive') {
        e.preventDefault()
        setTimeout(() => $(`.js-header-jumplink[data-jump="${hash}"]`).trigger('click'))
      } else if (videoAccordion.length) {
        jumpToAccordion(videoAccordion)
      }
    }
  })
  $(window).trigger('hashchange')

  $(document).on('click', '.js-anchor-click', (e) => {
    location.hash = '#issues'
    $(window).trigger('hashchange')
    e.preventDefault()
  })

  $(document).on('click', '.js-article-ad-sound', function () {
    const button = $(this)
    const player = button.closest('.article-ad__inner').find('.cb-player')

    if (button.hasClass('article-ad__sound--off')) {
      button.removeClass('article-ad__sound--off')
      player.cbplayer('mediaSetVolume', 100)
    } else {
      button.addClass('article-ad__sound--off')
      player.cbplayer('mediaSetVolume', 0)
    }
  })

  // Keep up to date with history changes
  window.addEventListener('popstate', function (e) {
    if (location.hash) {
      return false
    }

    if (activeAfterPageLoad != false) {
      location.reload()
    }
  }, false)

  function loadMore(panel) {
    panel.addClass('is-loading')

    const pageUrl = panel.data('load-more-url')
    let currentPage = panel.data('current-page')

    return new Promise(function (resolve, reject) {
      if (pageUrl != undefined && pageUrl != null) {
        panel.addClass('is-loading')
        if (currentPage == undefined) {
          currentPage = 0
        }
        currentPage = currentPage + 1
        panel.data('current-page', currentPage)
        fetch(pageUrl.replace('%d', currentPage))
          .then(res => res.text())
          .then(html => {
            html = $(html)
            const hasMore = html.children().length > 0
            if (hasMore) {
              // Show more items
              html.children().appendTo(panel)
            } else {
              // No more items, don’t try to load more items
              panel.data('load-more-url', null)
            }
            panel.removeClass('is-loading')
            resolve(hasMore)
          })
      }
    })
  }

  $(document).on('click', '.js-header-jumplink', function () {
    const el = $(this)
    const section = $('.announcements__group[data-section="' + el.data('jump') + '"]')
    const marquee = el.closest('.main').find('.marquee')

    if (section.length) {
      let position = section.offset().top - $('.header').height() + 1

      if (el.closest('.header__dropdown').length) {
        el.closest('.header__dropdown').removeClass('header__dropdown--open')
      }

      if (marquee.length) {
        position = position - marquee.height()
      }

      $('html, body').animate({
        scrollTop: position
      }, 300)
    }
  })

  $(document).on('click', '.related-dot', function () {
    const dot = $(this)
    const slider = dot.closest('.related').find('.related__carousel')

    slider.removeClass('related__carousel-snap-active')

    const selectedSlide = slider.find('.related__item').eq(dot.index())

    const selectedSlidePosition = slider.scrollLeft() + selectedSlide.offset().left

    slider.animate({
      scrollLeft: selectedSlidePosition + 'px'
    }, 250, () => slider.addClass('related__carousel-snap-active'))
  })

  $(document).on('click', '.js-related__item-thumb', function () {
    const slide = $(this)

    const container = $(this).closest('.block-media').find('.block-media-exhibition')
    const caption = container.find('.block-media-exhibition__caption')
    const image = container.find('.block-media-exhibition__image')

    // Clear
    container.removeClass('block-media-exhibition--landscape block-media-exhibition--portrait')
    caption.empty()
    image.empty()

    // Add new image

    if (slide.data('ratio') >= 1) {
      container.addClass('block-media-exhibition--landscape')
    } else {
      container.addClass('block-media-exhibition--portrait')
    }

    caption.html(slide.data('caption'))
    image.css('padding-bottom', 1 / slide.data('ratio') * 100 + '%');
    slide.find('img').clone().appendTo(image)


    lazySizes.autoSizer.checkElems()

  })

  $(document).on('click', '.js-form__checkbox-button', function (e) {
    const button = $(this)
    const checkbox = $('.form__checkbox-input[id="' + button.data('for') + '"]')
    let allCheckedCheckboxes = button.closest('.form__wrap-checkbox-group').find('.form__checkbox-input:checked')
    if (allCheckedCheckboxes.length == 0) {
      allCheckedCheckboxes = button.closest('.form__wrap-checkbox-group').find('.form__checkbox-input[defaultChecked=true]')
    }

    if (allCheckedCheckboxes.length == 1) {
      if (!checkbox.prop('checked')) {
        checkbox.prop('checked', !checkbox.prop('checked'))
      }
    } else {
      checkbox.prop('checked', !checkbox.prop('checked'))
    }
  })

    $(document).on('click', '.js-load-more-books', function () {
      const button = $(this)
