  const filterCalendar = $('.js-filter-calendar')
  if (filterCalendar.length) {

    let minYear = 2001
    if (filterCalendar.data('minyear')) {
      minYear = filterCalendar.data('minyear')
    }

    const maxYear = new Date().getFullYear() + 1

    filterCalendar.daterangepicker({
      locale: {
        format: 'MM/DD/YYYY',
        daysOfWeek: [
          'S',
          'M',
          'T',
          'W',
          'T',
          'F',
          'S'
        ],
        applyLabel: 'Select'
      },
      autoUpdateInput: false,
      linkedCalendars: false,
      showDropdowns: true,
      minYear: minYear,
      maxYear: maxYear
    });

    filterCalendar.on('show.daterangepicker', function (e, p) {
      $(this).closest('.filter-category').addClass('filter-category--open')

      const calendar = $(p.container[0])

      if (!calendar.find('.daterangepicker__inner').length) {
        calendar.children().wrapAll('<div class="daterangepicker__inner"></div>')
        calendar.find('.daterangepicker__inner').append('<div class="daterangepicker__close"></div>')
      }
    })

    filterCalendar.on('hide.daterangepicker', function (e, p) {
      $(this).closest('.filter-category').removeClass('filter-category--open')
    })

    filterCalendar.on('apply.daterangepicker', function (e, p) {

      const dates = $(this).closest('.filter-category').find('.filter-dates')
      const selectedItems = $(this).closest('.filter-category').find('.filter-category__selected')

      // $('#filterstartdate').val(p.startDate.format('MM/DD/YYYY'))
      // $('#filterenddate').val(p.endDate.format('MM/DD/YYYY'))

      const label = p.startDate.format('MM/DD/YYYY') + ' - ' + p.endDate.format('MM/DD/YYYY')
      const value = p.startDate.format('YYYY-MM-DD') + ',' + p.endDate.format('YYYY-MM-DD')

      // Remove current selection
      dates.empty()
      selectedItems.empty()

      // Add filter item
      $('<span class="filter-item-clickable filter-item-clickable--selected js-filter-item" />')
        .data('filter', value)
        .data('id', value)
        .data('name', 'ed')
        .appendTo(dates)

      // Add selected item
      $('<span class="filter-category__selected-item" />')
        .data('id', value)
        .text(label)
        .appendTo(selectedItems)

      // Show selected items
      selectedItems.addClass('filter-category__selected--visible')

      // Reset select
      $(this).data('daterangepicker').setStartDate(moment().format("MM-DD-YYYY")); //date now
      $(this).data('daterangepicker').setEndDate(moment().format("MM-DD-YYYY")); //date now

      updateSearchResults()
    })

    $(document).on('click', '.daterangepicker__close', function () {
      filterCalendar.data('daterangepicker').hide()
    })

    $(window).on('scroll', function () {
      if (!isMobile()) {
        filterCalendar.data('daterangepicker').hide()
      }
    })
  }



