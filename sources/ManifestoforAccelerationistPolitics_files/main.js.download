      articleBody.find('.js-article-ad').removeClass('article-ad--hidden')
    }
  }

  // check for chrome - clip-path + fixed bug
  const articleAd = $('.js-article-ad:not(.article-ad--landing)')
  if (articleAd.length) {
    if (/chrom(e|ium)/.test(navigator.userAgent.toLowerCase())) {
      articleAd.addClass('article-ad--chrome')
    } else if (/^((?!chrome|android).)*safari/i.test(navigator.userAgent.toLowerCase())) {
      const userAgent = navigator.userAgent
      const versionIndex = navigator.userAgent.indexOf('Version')
      const version = userAgent.substr(versionIndex, 10).split('/')

      // Check is safari version 14 or older
      // Use Chrome style for Ad
      if (version[1] <= 14) {
        articleAd.addClass('article-ad--chrome')
      } else {
        articleAd.addClass('article-ad--safari')
      }
    }
  }

  adFitItem()

  if ($.isFunction($.fn.cbplayer)) {
    $('.js-ad-video').cbplayer({
