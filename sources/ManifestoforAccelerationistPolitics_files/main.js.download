function reinitForm(){
  $('.js-overlayer-form').ajaxForm({
    beforeSubmit: function (formData, form, options) {
      const captcha = $('input[name="g-recaptcha-response"][value!=""]')
      let error = false
      console.log(captcha.val())
      if (captcha.val()=="") {
        $(".js-overlayer-subscribeform #error-captcha").text("Please submit the captcha")
        error = true
      }

      window.fetch("https://eflux-api.validev.io/api/checkCaptcha?g-recaptcha-response="+captcha.val(),{
        method: 'POST',
        dataType: 'json',
        data:{
          "g-recaptcha-response": captcha.val()??""
        }
      }).then(function (response) {
        if(!response.ok){
          error = true
        }
      })

      if (error) {
        return false
      }
      form.find('.button--submit').prop('disabled', true)
    },
    success: function (response, status, xhr, form) {
      if (response.ok) {
        if (form.hasClass('js-close-after-submit')) {
          closeOverlayerForm(form.closest('.overlayer-form'))
        } else {
          form.addClass('el-hidden')

          if (form.closest('.overlayer-form--inline').length) {
            form.closest('.overlayer-form--inline').find('.overlayer-form__successful').removeClass('el-hidden')
          } else {
            form.closest('.overlayer-form__content').find('.overlayer-form__successful').removeClass('el-hidden')
            window.history.pushState(null, null, window.location.origin + window.location.pathname)
          }
          $(".button--rsvpbutton--ticket").hide()
        }
      } else {
        if (response.missing) {
          const prefix = form.data('type')

          $.each(response.missing, function (i, fieldName) {
            $('[name="' + prefix + '_' + fieldName + '"]').closest('.form__wrap-input, .form__wrap-checkbox, .form__wrap-textarea').addClass('form__wrap--error')
          })
        }
      }
    }
  })

  $('.js-overlayer-subscribeform').ajaxForm({
    beforeSubmit: function (formData, form, options) {
      let error = false

      const email = form.find('input[name="email"]')
      if (email.val()) {
        if (!isEmail(email.val())) {
          email.closest('.form__wrap-input').addClass('form__wrap--error')
          error = true
        }
      } else {
        email.closest('.form__wrap-input').addClass('form__wrap--error')
        error = true
      }

      const privacy = form.find('input[name="privacy"]')
      if (!privacy.is(':checked')) {
        privacy.closest('.form__wrap-checkbox ').addClass('form__wrap--error')
        error = true
      }
      const captcha = $('input[name="g-recaptcha-response"][value!=""]')

      window.fetch("https://eflux-api.validev.io/api/checkCaptcha?g-recaptcha-response="+captcha.val(),{
        method: 'POST',
        dataType: 'json',
        data:{
          "g-recaptcha-response": captcha.val()??""
        }
      }).then(function (response) {
        if(!response.ok){
          error = true
        }
      })
      if (captcha.val()=="") {
        $(".js-overlayer-subscribeform #error-captcha").text("Please submit the captcha")
        error = true
      }else {
        $(".js-overlayer-subscribeform #error-captcha").text("")
      }
      if (error) {
        return false
      }

      form.find('.button--submit').prop('disabled', true)
    },
    success: function (response, status, xhr, form) {
      if (response.ok) {
        form.addClass('el-hidden')
        form.closest('.overlayer-form__content').find('.overlayer-form__successful').removeClass('el-hidden')
        window.history.pushState(null, null, window.location.origin + window.location.pathname)
      } else {
        if (response.missing) {
          $.each(response.missing, function (i, fieldName) {
            $('[name="' + fieldName + '"]').closest('.form__wrap-input, .form__wrap-checkbox').addClass('form__wrap--error')
          })
        }

        form.find('.button--submit').prop('disabled', false)
      }
    }
  })
}
// Subscribe handle
const subscribeBanner = $('.landing-subscribe')
const subscribePopup = $('.subscribe-popup-custom')

let subscribePopupActive = false

if (!getCookie('hidesubscribepopup')) {
  // Show subscribe popup after 10s
  subscribePopupActive = true

  setTimeout(() => {
    $(".subscribe-popup-custom").fadeIn(300)
  }, 10000)
}

$(document).on('click', '.js-subscribe-popup-close', function () {
  closeSubscribePopup($(this))
})

// Show bottom banner
if (!getCookie('hidesubscribeform') && subscribePopupActive === false) {

  // Log page loads
  logPageLoads()

  // After 3 page loads show bottom subscribe banner
  if (readPageLoads() >= 3) {
    subscribeBanner.show()
  }
} else if (getCookie('hidesubscribeform')) {
  resetPageLoads()
}

$(document).on('click', '.js-landing-subscribe-close', function () {
  closeSubscribeInfo($(this))
})



function closeSubscribePopup(item) {
  item.fadeOut()

  // Hide popup for one day
  const d = new Date();
  d.setTime(d.getTime() + (24 * 60 * 60 * 1000));
  const expires = "expires=" + d.toUTCString();

  document.cookie = 'hidesubscribepopup=1; ' + expires + ';path=/'
}

function readPageLoads() {
  const key = 'subscribe-banner-page-loads'
  return localStorage.getItem(key)
}

function resetPageLoads() {
  const key = 'subscribe-banner-page-loads'
  localStorage.setItem(key, 0)
}
