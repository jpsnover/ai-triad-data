    success: function (response, status, xhr, form) {
      console.log(response)
      if (response.ok) {
        form.addClass('el-hidden')
        form.closest('.overlayer-form__content').find('.overlayer-form__successful').removeClass('el-hidden')
        form.closest('.inline-subscribe').find('.inline-subscribe__thanks').removeClass('el-hidden')
        window.history.pushState(null, null, window.location.origin + window.location.pathname)
        $(".inline-subscribe").find('.inline-subscribe__thanks').removeClass('el-hidden')
      } else {
        if (response.missing) {
          $.each(response.missing, function (i, fieldName) {
            form.find('[name="' + fieldName + '"]').closest('.form__wrap-input, .form__wrap-checkbox').addClass('form__wrap--error')
          })
        }

        form.find('.button--submit').prop('disabled', false)
      }
    }
  })
  $('.js-overlayer-subscribeform-client').ajaxForm({
    beforeSubmit: function (formData, form, options) {
      const captcha = $('input[name="g-recaptcha-response"][value!=""]')
      let error = false

      if (captcha.val()=="") {
        $(".js-overlayer-subscribeform #error-captcha").text("Please submit the captcha")
        error = true
      }

      window.fetch("https://eflux-api.validev.io/api/checkCaptcha?g-recaptcha-response="+captcha.val(),{
        method: 'POST',
        dataType: 'json',
        data:{
          "g-recaptcha-response": captcha.val()??""
        }
      }).then(function (response) {
        if(!response.ok){
          error = true
        }
      })

      if (error) {
        return false
      }
      form.find('.button--submit').prop('disabled', true)
    },
    success: function (response, status, xhr, form) {
      if (response.ok) {
        form.addClass('el-hidden')
        form.closest('.overlayer-form__content').find('.overlayer-form__successful').removeClass('el-hidden')
        window.history.pushState(null, null, window.location.origin + window.location.pathname)
      } else {
        if (response.missing) {
          $.each(response.missing, function (i, fieldName) {
            $('[name="' + fieldName + '"]').closest('.form__wrap-input, .form__wrap-checkbox').addClass('form__wrap--error')
          })
        }

        form.find('.button--submit').prop('disabled', false)
      }
