setScreenHeight()

function relatedCarouselStop(scroller) {
  const scrollPosition = scroller.scrollLeft()
  const dots = scroller.closest('.related').find('.related__dots')

  if (dots.length) {
    scroller.find('.related__item').each(function (i, e) {

      if ($(e).position().left + ($(e).width() / 2) >= 0) {
        const currentIndex = $(e).index()

        //change dots
        dots.find('.related-dot').removeClass('related-dot--selected')

        dots.find('.related-dot').eq(currentIndex).addClass('related-dot--selected')

        return false;
      }
    })
  }
}

function initMarquee(update = false) {
  const marquees = $('.js-marquee')

  if (marquees.length) {
    marquees.each(function () {
      const container = $(this)
      const slider = container.find('.marquee__slider-inner')

      if (!container.hasClass('marquee--initialized') || update) {

        const slide = container.find('.marquee__slide').eq(0)
        const textWidth = slide.outerWidth()
        const animationName = 'anaimation-' + Math.floor(Math.random() * 26) + Date.now()

        if (container.hasClass('marquee--initialized')) {
          slider.resetKeyframe()
        }

        slider.css({
          'animation-name': animationName,
          'animation-duration': '15s'
        })

        $.keyframe.define({
          name: animationName,
          from: {
            'margin-left': '0px'
          },
          to: {
            'margin-left': '-' + textWidth + 'px'
          }
        })
      }
    })
  }
}

function jumpToAccordion(videoAccordion) {
  if (videoAccordion.length) {

    // Close open accordion
    const firstAccordion = $('.video-accordion')
    firstAccordion.removeClass('video-accordion--open')
    firstAccordion.find('.video-accordion__content').hide()

    // Open selected accordion
    videoAccordion.addClass('video-accordion--open')
    videoAccordion.find('.video-accordion__content').show()

    videoCarouselStyle()
    videoCarouselGradient()

    let position = videoAccordion.offset().top - $('.header').height() + 1
    const marquee = $('.marquee')

    if (marquee.length) {
      position = position - marquee.height()
    }

    $(window).scrollTop(position)

  }
}

