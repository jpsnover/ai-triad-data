// - - - - - - - - - - - - - - - - - - - - - - - - - -
// Register plugins
// - - - - - - - - - - - - - - - - - - - - - - - - - -



window.onload = function () {
	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	// Declarations
	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	const banner = document.getElementById("banner"),
		bgWrap = document.getElementById("bg-wrap"),
		bgPortraitWrap = document.getElementById("bg-portrait-wrap"),
		bgPortrait04 = document.getElementById("bg-portrait-04"),
		greyout = document.getElementById("greyout"),
		logo = document.getElementById("logo"),
		endHl = document.getElementById("end-hl"),
		endTl = document.getElementById("end-tl"),
		endCta = document.getElementById("end-cta"),
		clickTag = document.getElementById("click-tag");



	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	// GSAP timeline, main
	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	const tlMain = gsap.timeline({ repeat: 1, repeatDelay: 4 });

	tlMain
		.set(bgWrap, { scale: 1, x: 0, y: 0 })
		.set(bgPortraitWrap, { width: 242 })
		.set(bgPortrait04, { x: -79 })
		// Resets
		.to(banner, { duration: 0.2, autoAlpha: 1 })
		// Frame 01
		.call(bgAnim, this, null)
		// Endframe
		.to(greyout, { duration: 0.5, opacity: 0.41 }, "+=1.2")
		.to([endHl, endTl, logo, endCta], { duration: 0.3, x: 0, y: 0, autoAlpha: 1, ease: "power3" }, "-=0.3");

	// log duration
	// console.log("tlMain duration: " + tlMain.totalDuration());



	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	// Util functions
	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	function bgAnim() {
		const tlBgAnim = gsap.timeline();
		tlBgAnim
			.to(bgWrap, { duration: 2, scale: 3.1, x: -485, y: 50, ease: "power3.inOut" })
			.to(bgPortraitWrap, { duration: 2, width: 321, ease: "power3.inOut" }, "-=2")
			.to(bgPortrait04, { duration: 2, x: 0, ease: "power3.inOut" }, "-=2")
	}



	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	// Event handling
	// - - - - - - - - - - - - - - - - - - - - - - - - - -
	function handleOver() {
		gsap.to(endCta, { duration: 0.3, css: { backgroundColor: "#FFF488" } });
	}
	function handleOut() {
		gsap.to(endCta, { duration: 0.3, css: { backgroundColor: "#FEEB29" } });
	}

	clickTag.addEventListener('mouseover', handleOver);
	clickTag.addEventListener('mouseout', handleOut);
}