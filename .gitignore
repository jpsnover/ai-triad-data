# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.bak

# Secrets — never commit API keys, even encrypted
.aitriad-key-*.enc
*.key
.env
*.env

# Flight recorder dumps — may contain sensitive data (API keys, session tokens)
flight-recorder/
# writeDump actually writes to admin/flight-recorder-dumps/{client,server}-<id>.jsonl (t/3050);
# ignore the sensitive dumps but keep the tracked dumps-index.json metadata
admin/flight-recorder-dumps/*.jsonl

# Web snapshot artifacts (JS/CSS captured with HTML saves)
*_files/

# Working/review documents
taxonomy/hierarchy-proposals/
policy_pass*_review.md

# Large generated files (use per-POV .npy + index files instead)
taxonomy/Origin/synthetic/synthetic_embeddings.json


# Class-A runtime state — generated at runtime, must survive git clean -fd (t/2645)
# (admin/errors/ stays tracked — error logs are not class-A state)
admin/feature-flags.json
admin/feature-flags-audit.ndjson
admin/runtime-config.json
admin/telemetry/
calibration/
.githooks/__pycache__/

# Raw LLM response dumps written by summarisation on parse failure (debug only; never tracked)
summaries/*.debug-raw.txt

# Advisory writer lockfiles — transient, created beside the file they guard and deleted on release
# (t/4028 policy registry lock; t/3203 / t/3163#1 grounding lock shared with reconcile_grounding.py).
# A held or stranded lock must never be swept into a commit by a broad `git add`.
policy_actions.lock
entity_mentions.lock
