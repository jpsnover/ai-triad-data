# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.bak

# Secrets — never commit API keys, even encrypted
.aitriad-key-*.enc
*.key
.env
*.env

# Flight recorder dumps — may contain sensitive data (API keys, session tokens)
flight-recorder/

# Web snapshot artifacts (JS/CSS captured with HTML saves)
*_files/

# Working/review documents
taxonomy/hierarchy-proposals/
policy_pass*_review.md

# Large generated files (use per-POV .npy + index files instead)
taxonomy/Origin/synthetic/synthetic_embeddings.json


# Class-A runtime state — generated at runtime, must survive git clean -fd (t/2645)
# (admin/errors/ stays tracked — error logs are not class-A state)
admin/feature-flags.json
admin/feature-flags-audit.ndjson
admin/runtime-config.json
admin/telemetry/
calibration/
