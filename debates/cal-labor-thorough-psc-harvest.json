  "verdicts": [
    {
      "id": "hv-0",
      "conflict": "Whether the contraction of entry-level roles constitutes a permanent loss of institutional competence or a necessary transition to synthetic mastery.",
      "prevails": "Sentinel (C2)",
      "criterion": "logical_validity",
      "rationale": "Sentinel correctly identifies that simulations are bounded by training data and fail to replicate the 'black swan' events found in real-world environments. Prometheus relies on the assumption that synthetic environments can capture the full complexity of human experience, which lacks empirical verification in high-stakes professional fields.",
      "whatWouldChange": "Evidence demonstrating that AI-trained personnel maintain equivalent incident-response performance to traditionally mentored staff during novel, non-linear crises.",
      "claimIds": [
        "C2",
        "C3"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-1",
      "conflict": "The nature and long-term impact of the 'auditing tax' (the cognitive cost of verifying AI output).",
      "prevails": "Cassandra",
      "criterion": "specificity",
      "rationale": "Cassandra provides a concrete, albeit estimated, metric of a 30% cognitive bandwidth loss, highlighting a measurable operational drag. Prometheus offers an optimistic projection that model interpretability will resolve the issue, but fails to account for the persistent, high-stakes verification requirements inherent in probabilistic systems.",
      "whatWouldChange": "Longitudinal data showing a decline in human verification time per unit of AI output across diverse industries.",
      "claimIds": [
        "C1",
