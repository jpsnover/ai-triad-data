      "point": "Can human expertise be formalized into autonomous agentic architectures?",
      "bdiLayer": "belief",
      "resolvability": "resolvable_by_evidence",
      "positions": [
        {
          "pover": "Accelerationist",
          "stance": "Yes, tacit knowledge is just a set of latent variables that can be captured and encoded."
