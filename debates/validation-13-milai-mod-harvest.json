  "verdicts": [
    {
      "id": "hv-0",
      "conflict": "Centralized metrics-based governance (AMAGF) vs. market-based liability",
      "prevails": "C2",
      "criterion": "scope",
      "rationale": "Sentinel correctly identifies that high-entropy military environments prioritize drift prevention over raw speed. Prometheus focuses on tactical latency but ignores the catastrophic, non-recoverable failures inherent in unmonitored autonomous systems.",
      "whatWouldChange": "Evidence demonstrating that autonomous systems can maintain stability in contested electronic warfare environments without external telemetry.",
      "claimIds": [
        "C1",
        "C2"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-1",
      "conflict": "Metrics-based governance vs. commander deskilling",
      "prevails": "undecidable",
      "criterion": "empirical_evidence",
      "rationale": "Both sides rely on speculative claims about human cognitive performance under future AI integration. We lack longitudinal data on whether Control Quality Scores (CQS) function as cognitive aids or crutches in real-world combat scenarios.",
      "whatWouldChange": "Controlled behavioral experiments measuring decision-making accuracy and latency of commanders using CQS versus raw data streams during high-stress simulations.",
      "claimIds": [
        "C5",
        "C6"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-2",
      "conflict": "Insurance-backed liability vs. regulatory-mandated telemetry",
      "prevails": "C4",
      "criterion": "logical_validity",
      "rationale": "Sentinel identifies a structural gap in the liability model: private insurers lack the technical access to verify internal model architectures. Prometheus assumes insurers can force transparency, but fails to explain how they overcome the 'audit-washed' problem without federal oversight.",
      "whatWouldChange": "A pilot program showing private insurers successfully enforcing open-standard telemetry requirements on defense contractors.",
      "claimIds": [
        "C3",
        "C4"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    }
