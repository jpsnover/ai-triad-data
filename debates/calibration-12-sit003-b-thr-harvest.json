  "verdicts": [
    {
      "id": "hv-0",
      "conflict": "Whether a binding global governance framework is a technical necessity to prevent catastrophic failure.",
      "prevails": "undecidable",
      "criterion": "empirical_evidence",
      "rationale": "Safetyist relies on a 'race to the bottom' hypothesis, but Accelerationist correctly identifies that high-cost compliance creates 'regulatory moats' that stifle competition. Neither side provides empirical data on whether centralized safety protocols actually reduce catastrophic risk more effectively than decentralized, open-source auditing.",
      "whatWouldChange": "Longitudinal data from pilot programs comparing the safety incident rates of centralized, regulated models versus open-source models operating under decentralized oversight.",
      "claimIds": [
        "C1",
        "C2",
        "C4"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-1",
      "conflict": "Whether liability frameworks constitute market-based accountability or regulatory capture.",
      "prevails": "C6",
      "criterion": "scope",
      "rationale": "Skeptic accounts for the broader social impact of insurance models, noting that they financialize systemic inequities rather than solving them. Safetyist’s focus on 'internalizing social costs' ignores the reality that large firms often treat insurance premiums as a predictable cost of doing business, which fails to deter discriminatory outcomes.",
      "whatWouldChange": "Evidence demonstrating that insurance-based liability models have successfully reduced algorithmic bias or systemic discrimination in high-stakes sectors like finance or housing.",
      "claimIds": [
        "C5",
        "C6"
      ],
      "targetConflictId": null,
