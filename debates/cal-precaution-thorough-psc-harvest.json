      "point": "The primary mechanism for ensuring safety in high-stakes AI systems.",
      "bdiLayer": "desire",
      "resolvability": "negotiable_via_tradeoffs",
      "positions": [
        {
          "pover": "Safetyist",
          "stance": "Mandatory, tiered pre-deployment verification combined with continuous, independent, domain-specific auditing."
        },
        {
          "pover": "Accelerationist",
          "stance": "Market-driven liability reserves (bonds) that force firms to internalize risk without centralized, ex-ante permissioning."
        },
        {
          "pover": "Skeptic",
          "stance": "Open-source, public-interest auditing infrastructure that mandates continuous, performance-based reporting rather than static gates."
