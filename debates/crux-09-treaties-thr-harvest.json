      "id": "hc-0",
      "point": "Whether liability-based financial incentives can effectively prevent existential risks.",
      "bdiLayer": "belief",
      "resolvability": "resolvable_by_evidence",
      "positions": [
        {
          "pover": "prometheus",
          "stance": "Symmetric litigation exposure and risk-proportional reserves force firms to price existential risk out of the market."
        },
        {
          "pover": "sentinel",
          "stance": "Liability is a post-mortem tool; it cannot function when the event destroys the legal and financial infrastructure required to adjudicate it."
        }
      ],
