  "verdicts": [
    {
      "id": "hv-0",
      "conflict": "Whether capital-dividend models can replace wage-based distribution without causing systemic collapse.",
      "prevails": "C6",
      "criterion": "scope",
      "rationale": "Skeptic correctly identifies that economic stability relies on institutional trust and legal enforcement, which require human-scale time to build. Accelerationist ignores the reality that a dividend system requires a functioning state to collect and redistribute, which would likely have already failed if the transition to automation happens at the speed of machine-learning cycles.",
      "whatWouldChange": "Evidence of a successful, large-scale transition to an automated dividend model in a jurisdiction without pre-existing, strong, human-led institutional stability.",
      "claimIds": [
        "C5",
        "C6"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-1",
      "conflict": "Whether human-in-the-loop mandates are necessary at the point of production.",
      "prevails": "C1",
      "criterion": "logical_validity",
      "rationale": "Accelerationist treats the shift to AI-centric production as an inevitable evolutionary law, but this ignores the active policy choices that concentrate infrastructure ownership. Skeptic identifies the root cause as a political distribution problem, which is more logically consistent with historical patterns of technological adoption.",
      "whatWouldChange": "Empirical proof that AI-driven production can maintain economic output without any human oversight or infrastructure maintenance.",
      "claimIds": [
        "C1",
        "C2"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-2",
      "conflict": "Whether institutional adaptation is fixed at a non-accelerable human pace.",
      "prevails": "C4",
      "criterion": "empirical_evidence",
      "rationale": "Safetyist asserts a specific computational threshold of 10^26 FLOPS for opacity, but lacks a peer-reviewed consensus to support this limit. Current research into interpretability suggests that opacity is a design choice or a current technical limitation rather than an inherent law of physics at a specific FLOP count.",
      "whatWouldChange": "A validated, industry-standard metric or experimental result confirming that models at 10^26 FLOPS consistently exhibit non-interpretable emergent behaviors.",
      "claimIds": [
        "C3",
        "C4"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    }
