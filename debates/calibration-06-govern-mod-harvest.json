  "verdicts": [
    {
      "id": "hv-0",
      "conflict": "Does compute power serve as a reliable proxy for the severity of societal harm?",
      "prevails": "Skeptic",
      "criterion": "scope",
      "rationale": "Skeptic correctly identifies that harm is a function of deployment context, not just model scale. Accelerationist ignores that a small, biased algorithm in a municipal hiring portal can inflict more immediate, measurable civil rights damage than a massive, un-deployed frontier model.",
      "whatWouldChange": "Evidence demonstrating that frontier-scale models possess unique, high-probability 'existential' risks that small-scale models cannot replicate, regardless of the deployment domain.",
      "claimIds": [
        "C1",
        "C2"
      ],
      "targetConflictId": null,
      "checked": false,
      "warnings": []
    },
    {
      "id": "hv-1",
      "conflict": "Should governance prioritize market-driven open-source verification or state-mandated procedural audits?",
      "prevails": "Accelerationist",
      "criterion": "specificity",
      "rationale": "Accelerationist highlights a critical administrative barrier: the 'compliance moat' that prevents startups from competing with industry giants. While Safetyist seeks accountability, they fail to provide a mechanism that prevents bureaucratic overhead from centralizing power among firms with large legal and compliance departments.",
      "whatWouldChange": "A pilot program demonstrating that standardized audit templates can be executed by small teams without significant financial or labor drain.",
      "claimIds": [
        "C4",
        "C6"
      ],
      "targetConflictId": null,
      "checked": false,
