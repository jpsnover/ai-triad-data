      "point": "Does compute power serve as a reliable proxy for the severity of societal harm caused by an AI model?",
      "bdiLayer": "belief",
      "resolvability": "resolvable_by_evidence",
      "positions": [
        {
          "pover": "Accelerationist",
          "stance": "Yes; compute-to-risk ratios are the only objective way to identify emergent, non-linear hazards that justify state intervention."
