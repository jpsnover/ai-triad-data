      "point": "Should monitoring logic for secure enclaves be proprietary (closed) or open-source?",
      "bdiLayer": "desire",
      "resolvability": "negotiable_via_tradeoffs",
      "positions": [
        {
          "pover": "sentinel",
          "stance": "Monitoring logic should be proprietary to prevent models from identifying and exploiting vulnerabilities in the code, which would turn transparency into an attack surface."
        },
        {
          "pover": "cassandra",
          "stance": "Monitoring logic must be open-source to ensure public accountability and prevent 'audit washing' by corporations."
        }
